{
  "name": "kinetech",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "packages/core",
    "packages/tokens",
    "packages/bridge",
    "packages/playback-token",
    "packages/video-source",
    "backend/video-worker",
    "tools/upload-lesson"
  ],
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/web",
    "test:unit": "npm run test:unit --workspace=apps/web && npm run test --workspace=packages/playback-token && npm run test --workspace=packages/video-source && npm run test --workspace=backend/video-worker",
    "test:e2e": "npm run test:e2e --workspace=apps/web",
    "lesson:upload": "npm run upload --workspace=tools/upload-lesson --"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261110.1": true,
    "@parcel/watcher@2.6.0": true
  }
}
