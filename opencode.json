{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["docs/ARCHITECTURE.md"],
  "permission": {
    "task": {
      "*": "deny",
      "architect": "allow",
      "tester": "allow",
      "reviewer": "allow"
    },
    "skill": { "*": "allow" },
    "bash": {
      "*": "allow",
      "git push*": "ask",
      "git reset --hard*": "ask",
      "git clean*": "ask",
      "rm -rf*": "ask",
      "git commit*--no-verify*": "deny"
    },
    "edit": {
      "*": "allow",
      "opencode.json": "ask",
      ".github/workflows/*": "ask",
      ".github/CODEOWNERS": "ask",
      "docs/ARCHITECTURE.md": "ask",
      ".arch-rules": "ask",
      ".importlinter": "ask",
      ".dependency-cruiser.cjs": "ask"
    }
  }
}
