{
  "expo": {
    "name": "KineTech",
    "slug": "kinetech",
    "version": "1.0.0",
    "scheme": "kinetech",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kinetech.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.kinetech.mobile"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {}
      ],
      "expo-font",
      [
        "expo-dev-client",
        {}
      ],
      "expo-status-bar"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "3d9573b0-bdc0-4f3a-bfa6-8829c092707f"
      }
    },
    "owner": "qhmed67"
  }
}
