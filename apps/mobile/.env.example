# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url_here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# API Configuration
EXPO_PUBLIC_API_BASE_URL=https://your-vercel-app.vercel.app

# NOTE: no GOOGLE_API_KEY here on purpose. Everything with the EXPO_PUBLIC_
# prefix is inlined into the shipped app bundle, so a Google key placed here
# would be readable by anyone who unzips the app. The Drive duration probe
# runs server-side (GOOGLE_API_KEY on Vercel, apps/web/api/drive-minutes.ts).
