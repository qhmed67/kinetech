{
  "name": "@kinetech/mobile",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "expo start --lan --dev-client",
    "dev:client": "expo start --lan --dev-client",
    "android": "expo start --android --lan --dev-client",
    "ios": "expo start --ios --lan --dev-client",
    "start": "expo start --lan --dev-client",
    "typecheck": "tsc --noEmit",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "build:all": "eas build --platform all"
  },
  "dependencies": {
    "@kinetech/bridge": "*",
    "@kinetech/core": "*",
    "expo": "~58.0.24",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "expo-video": "~58.0.14",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "^5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.2"
  }
}
