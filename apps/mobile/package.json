{
  "name": "@kinetech/mobile",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "expo start --lan",
    "android": "expo start --android --lan",
    "ios": "expo start --ios --lan",
    "start": "expo start --lan",
    "test:unit": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "test:bundle": "node e2e/bundle-check.mjs",
    "test:logs": "node e2e/logs-test.mjs",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "build:all": "eas build --platform all"
  },
  "dependencies": {
    "@expo-google-fonts/alexandria": "^0.2.3",
    "@expo-google-fonts/pacifico": "^0.4.1",
    "@expo-google-fonts/valley-sans": "^0.4.0",
    "@expo/vector-icons": "^15.1.1",
    "@kinetech/core": "*",
    "@kinetech/tokens": "*",
    "@kinetech/ui-native": "*",
    "expo": "~58.0.23",
    "expo-font": "~58.0.1",
    "expo-haptics": "~58.0.0",
    "expo-linear-gradient": "^58.0.3",
    "expo-linking": "~6.3.1",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.0",
    "expo-status-bar": "~3.0.0",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "^5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "^15.16.1",
    "react-native-vector-icons": "^10.0.3",
    "react-native-webview": "13.8.6"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.0",
    "jest": "^29.7.0",
    "jest-expo": "~58.0.0",
    "typescript": "~6.0.2"
