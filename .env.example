VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=paste_publishable_key_here

# --- Cloudflare R2 video delivery (server side, Vercel) ------------------------
# The base URL of the deployed Worker (backend/video-worker). The Worker is the
# ONLY door to the private R2 bucket.
VIDEO_WORKER_URL=https://kinetech-video.<your-subdomain>.workers.dev
# The HMAC secret that signs the playback tokens. It MUST be the same value as
# the Worker's GRANT_SECRET (set with `npx wrangler secret put GRANT_SECRET`).
# Never commit the real value.
PLAYBACK_GRANT_SECRET=paste_the_same_random_value_as_the_worker_secret
