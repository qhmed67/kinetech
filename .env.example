VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=paste_publishable_key_here

# --- Cloudflare R2 video delivery (server side, Vercel) ------------------------
# The base URL of the deployed Worker (backend/video-worker). The Worker is the
# ONLY door to the private R2 bucket. Swap the hostname freely: it is returned
# to the app by POST /api/playback/start, so nothing is hardcoded in the app.
#   production: https://kinetech-video.<your-subdomain>.workers.dev
#   local dev : http://localhost:8787   (npx wrangler dev)
VIDEO_WORKER_BASE_URL=https://kinetech-video.<your-subdomain>.workers.dev
# The HMAC secret that signs the playback tokens. It MUST equal the Worker's
# GRANT_SECRET (set with `npx wrangler secret put GRANT_SECRET`).
# Generate one with: openssl rand -hex 32
# Never commit the real value.
GRANT_SECRET=paste_the_same_random_value_as_the_worker_secret
